{
  "name": "aurora-odds-mcp",
  "version": "1.0.0",
  "description": "MCP server that tells a voice assistant whether the northern lights are worth going outside for, here and tonight.",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "dev": "node src/dev.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/worker.ts --bundle --format=esm --platform=browser --conditions=workerd,worker,browser --minify --outfile=site/_worker.js"
  },
  "author": "Kai Chen",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76",
    "aurora-sky": "github:luoy16002-svg/aurora-sky"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luoy16002-svg/aurora-odds-mcp.git"
  },
  "homepage": "https://aurora-odds-mcp.pages.dev",
  "engines": {
    "node": ">=22.18"
  }
}
